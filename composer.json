{
    "name": "dmlab/module-admin-sso",
    "description": "Admin panel SSO capability for Magento 2 — provider-agnostic OIDC login for the admin panel (JIT admin-user creation, IdP-group to ACL-role mapping, enforce-SSO + break-glass).",
    "type": "magento2-module",
    "license": "OSL-3.0",
    "version": "0.2.3",
    "keywords": [
        "magento2",
        "magento2-module",
        "magento 2",
        "sso",
        "single sign-on",
        "oidc",
        "openid connect",
        "admin login",
        "okta",
        "azure ad",
        "entra id",
        "google workspace"
    ],
    "homepage": "https://github.com/dmlab-work/module-admin-sso",
    "support": {
        "issues": "https://github.com/dmlab-work/module-admin-sso/issues",
        "source": "https://github.com/dmlab-work/module-admin-sso"
    },
    "require": {
        "php": "~8.2.0||~8.3.0||~8.4.0||~8.5.0",
        "magento/framework": "^103.0.7",
        "magento/module-authorization": "^100.4.7",
        "magento/module-backend": "^102.0.7",
        "magento/module-config": "^101.2.7",
        "magento/module-user": "^101.2.7",
        "dmlab/module-sso-core": "^0.2.3"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5||^12.5",
        "magento/module-two-factor-auth": "^1.1.6",
        "magento/module-security": "^100.4.7"
    },
    "suggest": {
        "magento/module-two-factor-auth": "Grants the 2FA session to SSO logins so the IdP MFA is not repeated",
        "magento/module-security": "Tracks SSO admin sessions and applies the Admin Account Sharing setting",
        "dmlab/module-admin-scim": "Automatic admin offboarding"
    },
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "DmLab\\AdminSso\\": ""
        }
    }
}
