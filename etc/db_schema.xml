<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <table name="admin_user">
        <!-- IdP identity (`sub` + `iss`) linked to this admin; the stable re-login key.
             Nullable so local-only admins keep empty values; unique so one IdP identity
             maps to at most one admin (MySQL allows many NULLs). -->
        <column xsi:type="varchar" name="dmlab_sso_subject_id" nullable="true" length="255"
                comment="DmLab SSO subject identifier"/>
        <column xsi:type="varchar" name="dmlab_sso_issuer" nullable="true" length="255"
                comment="DmLab SSO issuer identifier"/>
        <constraint xsi:type="unique" referenceId="DMLAB_ADMIN_SSO_SUBJECT_ISSUER">
            <column name="dmlab_sso_subject_id"/>
            <column name="dmlab_sso_issuer"/>
        </constraint>
    </table>
</schema>
