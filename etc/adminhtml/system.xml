<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <tab id="dmlab" translate="label" sortOrder="400">
            <label>DMLab</label>
        </tab>
        <section id="dmlab_admin_sso" translate="label" type="text" sortOrder="10"
                 showInDefault="1" showInWebsite="0" showInStore="0">
            <class>separator-top</class>
            <label>Admin SSO</label>
            <tab>dmlab</tab>
            <resource>DmLab_AdminSso::config</resource>
            <group id="general" translate="label" type="text" sortOrder="10"
                   showInDefault="1" showInWebsite="0" showInStore="0">
                <label>General</label>
                <field id="enabled" translate="label" type="select" sortOrder="10"
                       showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>Enable Admin SSO</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="active_provider" translate="label comment" type="select" sortOrder="20"
                       showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>Identity Provider</label>
                    <source_model>DmLab\AdminSso\Model\Config\Source\ActiveProvider</source_model>
                    <comment>The list is populated by installed provider plugins (e.g. admin-sso-okta).</comment>
                    <depends>
                        <field id="enabled">1</field>
                    </depends>
                </field>
                <field id="client_id" translate="label" type="text" sortOrder="30"
                       showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>Client ID</label>
                    <depends>
                        <field id="enabled">1</field>
                    </depends>
                </field>
                <field id="client_secret" translate="label" type="obscure" sortOrder="40"
                       showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>Client Secret</label>
                    <backend_model>Magento\Config\Model\Config\Backend\Encrypted</backend_model>
                    <depends>
                        <field id="enabled">1</field>
                    </depends>
                </field>
                <field id="enforce_sso" translate="label comment" type="select" sortOrder="50"
                       showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>Enforce SSO</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment>Blocks native password login on every admin path (login form, REST admin token). SSO-linked admins are always blocked while SSO is enabled.</comment>
                    <depends>
                        <field id="enabled">1</field>
                    </depends>
                </field>
                <field id="break_glass" translate="label comment" type="select" sortOrder="60"
                       showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>Allow Break-Glass Login</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment>Lets the usernames listed below keep native password login when SSO blocks it (Enforce SSO, or SSO-linked admins).</comment>
                    <depends>
                        <field id="enabled">1</field>
                    </depends>
                </field>
                <field id="break_glass_usernames" translate="label comment" type="textarea" sortOrder="65"
                       showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>Break-Glass Usernames</label>
                    <comment>One admin username per line (or comma-separated). Empty = no break-glass.</comment>
                    <depends>
                        <field id="break_glass">1</field>
                    </depends>
                </field>
                <field id="group_role_map" translate="label comment" type="textarea" sortOrder="70"
                       showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>Group to Role Map</label>
                    <comment>
                        <![CDATA[One <code>idp_group=role_id</code> per line; the first matching line wins. <code>#</code> comments ignored.]]>
                    </comment>
                    <depends>
                        <field id="enabled">1</field>
                    </depends>
                </field>
                <field id="default_role" translate="label comment" type="text" sortOrder="80"
                       showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>Default Role</label>
                    <comment>
                        <![CDATA[Role id when no group matches. Leave empty to refuse SSO login for unmapped users.]]>
                    </comment>
                    <depends>
                        <field id="enabled">1</field>
                    </depends>
                </field>
                <field id="trust_idp_mfa" translate="label comment" type="select" sortOrder="90"
                       showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>Trust IdP MFA</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment>
                        <![CDATA[Skip Magento 2FA only when the ID token proves MFA (<code>amr</code> contains <code>mfa</code>, or a factor such as <code>otp</code>/<code>hwk</code> plus another method; or a trusted <code>acr</code>). Without that evidence Magento 2FA still applies.]]>
                    </comment>
                    <depends>
                        <field id="enabled">1</field>
                    </depends>
                </field>
                <field id="trusted_acr_values" translate="label comment" type="textarea" sortOrder="95"
                       showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>Trusted ACR Values</label>
                    <comment>
                        <![CDATA[Optional. <code>acr</code> values your IdP issues only after MFA, one per line (or comma-separated).]]>
                    </comment>
                    <depends>
                        <field id="trust_idp_mfa">1</field>
                    </depends>
                </field>
            </group>
        </section>
    </system>
</config>
